---
layout: layouts/base.njk
title: GinaCities — Videos
---

<section class="window">
  <div class="titlebar">
    <svg class="icon pixel" aria-hidden="true"><use href="#i-games"/></svg>
    <span>youtube</span>
    <div class="icons"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
  </div>
  <div class="content">
    <div class="video-grid">
      <div class="video-item">
        <div class="video-wrap">
          <iframe
            src="https://www.youtube.com/embed/sCfOKttghTY?si=_qImFuwGhpbFIYlJ"
            title="video title"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen>
          </iframe>
        </div>
        <div class="video-caption">Why do we crave the 2000s internet so much?</div>
      </div>
      <div class="video-item">
        <div class="video-wrap">
          <iframe
            src="https://www.youtube.com/embed/QYRHYpf8C5Q?si=BNnCOAV_tiESVb8R"
            title="video title"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen>
          </iframe>
        </div>
        <div class="video-caption">Full devlog: Making Potion Puzzle Shop</div>
      </div>
    </div>
  </div>
</section>

<section class="window">
  <div class="titlebar">
    <svg class="icon pixel" aria-hidden="true"><use href="#i-games"/></svg>
    <span>shorts</span>
    <div class="icons"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
  </div>
  <div class="content">
    <div class="video-grid video-grid--short">
      {% for short in shorts %}
      <div class="video-item">
        <div class="video-wrap video-wrap--short">
          <iframe
            src="https://www.youtube.com/embed/{{ short.id }}"
            title="{{ short.title }}"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen>
          </iframe>
        </div>
        <div class="video-caption">{{ short.title }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>