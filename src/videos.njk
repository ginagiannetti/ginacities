---
layout: layouts/base.njk
title: GinaCities — Videos
---
<style>
  .video-thumb {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-play-btn {
  width: 56px;
  height: 56px;
  background: var(--win-lav);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: var(--dark);
  border: 3px solid var(--win-lav-light);
  box-shadow: 3px 3px 0 0 var(--win-pink-dark);
  transition: transform .12s ease;
}

.video-thumb:hover .video-play-btn {
  transform: translate(-2px, -2px);
}
</style>


<section class="window">
  <div class="titlebar">
    <img src="/assets/icons/hat.png" alt="witch's hat">
    <span>youtube</span>
    {% include "components/window-buttons.njk" %}
  </div>
  <div class="content">
    <div class="video-grid" id="long-video-container">
      <div class="video-item video-placeholder">
        <div class="video-wrap placeholder-box"></div>
        <div class="video-caption placeholder-caption"></div>
      </div>

      <div class="video-item video-placeholder">
        <div class="video-wrap placeholder-box"></div>
        <div class="video-caption placeholder-caption"></div>
      </div>
    </div>
  </div>
</section>

<section class="window">
  <div class="titlebar">
    <img src="/assets/icons/tarot.png" alt="tarot cards">
    <span>shorts</span>
    {% include "components/window-buttons.njk" %}
  </div>
  <div class="content">
    <div class="video-grid video-grid--short" id="short-video-container">
      <div class="video-item video-placeholder">
      <div class="video-wrap video-wrap--short placeholder-box"></div>
      <div class="video-caption placeholder-caption"></div>
    </div>

    <div class="video-item video-placeholder">
      <div class="video-wrap video-wrap--short placeholder-box"></div>
      <div class="video-caption placeholder-caption"></div>
    </div>

    <div class="video-item video-placeholder">
      <div class="video-wrap video-wrap--short placeholder-box"></div>
      <div class="video-caption placeholder-caption"></div>
    </div>
    <div class="video-item video-placeholder">
      <div class="video-wrap video-wrap--short placeholder-box"></div>
      <div class="video-caption placeholder-caption"></div>
    </div>
  </div>
   <div id="load-more-container"> 
    <button onclick="loadVideos('short', false)" class="pill load-more">Load more</button>
  </div>
  </div>
</section>

<script>
  const cursors = {
    long: null,
    short: null
  }
  async function loadVideos(type, firstUsage){
    try{
      let cursorText = cursors[type] ? ('&cursor=' + cursors[type]) : ""
      const response = await fetch('https://22xcto36m3firhfmgcwvoucefy0vzntn.lambda-url.eu-west-2.on.aws?type=' + type + '&limit=' + 20 + cursorText);
      
      if (!response.ok) {
        throw new Error(`HTTP error: ${response.status}`);
      }

      const videos = await response.json();
      const videoContainer = document.getElementById(type + '-video-container');

      cursors[type] = videos.nextCursor

      if(firstUsage){
        videoContainer
          .querySelectorAll('.video-placeholder')
          .forEach((placeholder) => placeholder.remove());
      }
      else if(!cursors[type]){
        const loadMore = document.getElementById('load-more-container')
        loadMore.style.display = 'none'
      }

      videos.items.forEach((video) => {
        if(video.published){
          let videoItem = document.createElement('div');
          let videoWrap = document.createElement('div');
          let iframe = document.createElement('iframe');
          let caption = document.createElement('div');
          iframe.setAttribute('title', video.title);
          iframe.setAttribute(
            'allow',
            'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
          );
          iframe.setAttribute('allowfullscreen', '');
          videoItem.className = 'video-item';
          videoWrap.className = 'video-wrap';
          caption.textContent = video.title;
          videoWrap.appendChild(iframe);
          videoItem.appendChild(videoWrap);
          videoItem.appendChild(caption);
          videoContainer.appendChild(videoItem);

          if(type === "long"){
            iframe.setAttribute('src', `https://www.youtube.com/embed/${video.id}`);
            caption.classList.add("video-caption");
          }

          else if(type === "short"){
            iframe.style.display = 'none';     
            videoWrap.classList.add("video-wrap--short")
            caption.className = 'video-caption';     
            const thumb = document.createElement('div');
            thumb.className = 'video-thumb';
            thumb.style.backgroundImage = `url(https://img.youtube.com/vi/${video.id}/mqdefault.jpg)`;
            thumb.innerHTML = '<div class="video-play-btn">&#9654;&#xFE0E;</div>';
            videoWrap.appendChild(thumb);
            thumb.addEventListener('click', () => {
              iframe.src = `https://www.youtube.com/embed/${video.id}?autoplay=1`;
              iframe.style.display = '';
              thumb.remove();
            });
          }
        }
      })
      } catch (error){
        console.error('Error:', error);
    }
  }

  loadVideos('long', true);
  loadVideos('short', true);
</script>