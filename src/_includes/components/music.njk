<section id="music" class="window">
  <div class="titlebar">
    <svg class="icon pixel" aria-hidden="true"><use href="#i-music"/></svg>
    <span>music player</span>
    {% include "components/window-buttons.njk" %}
  </div>
  <div class="content">
    <div class="player" role="group" aria-label="music player">
      <div class="cover" id="cover" aria-hidden="true"></div>
      <div>
        <strong>Now Playing:</strong> <em id="trackTitle">—</em><br/>
        <div class="buttons-row" style="margin-top:8px">
          <button data-umami-event="Clicked GinaCities Music Player" data-umami-event-type="Prev" class="btn" id="prevBtn" type="button" aria-label="previous track">⏮</button>
          <button data-umami-event="Clicked GinaCities Music Player" data-umami-event-type="Play/Pause" class="btn" id="playBtn" type="button" aria-label="play/pause">▶</button>
          <button data-umami-event="Clicked GinaCities Music Player" data-umami-event-type="Next" class="btn" id="nextBtn" type="button" aria-label="next track">⏭</button>
          <button data-umami-event="Clicked GinaCities Music Player" data-umami-event-type="Loop" class="btn" id="loopBtn" type="button" aria-label="toggle loop">🔁</button>
        </div>
        <div class="progress" id="progress" aria-label="timeline" role="slider" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
          <div class="bar" id="bar"></div>
        </div>
        <div class="time"><span id="cur">0:00</span> / <span id="dur">0:00</span></div>
        <label class="vol">
          vol
          <input id="vol" type="range" min="0" max="1" step="0.01" value="0.9" />
        </label>
      </div>
    </div>
    <audio id="audio" preload="metadata"></audio>
  </div>
</section>